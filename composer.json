{
    "name": "victorycodedev/shipday",
    "description": "A modern PHP SDK for the Shipday API.",
    "keywords": [
        "shipday",
        "shipday-api",
        "shipday-php-sdk",
        "delivery",
        "webhooks"
    ],
    "type": "library",
    "homepage": "https://github.com/victorycodedev/shipday",
    "license": "MIT",
    "authors": [
        {
            "name": "Efekpogua Victory",
            "email": "victrinhoj@gmail.com",
            "homepage": "https://github.com/victorycodedev/shipday",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Victorycodedev\\Shipday\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Victorycodedev\\Shipday\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
